{
  "expo": {
    "name": "Nkwa Asɛm",
    "slug": "nkwa-asem",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a52"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.bizzay4real.nkwaasem",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Allow local network access for offline Bible reading"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a3a52"
      },
      "package": "com.bizzay4real.nkwaasem",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone"
        }
      ]
    ],
    "scheme": "nkwaasem",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "nkwa-asem-project"
      }
    }
  }
}
